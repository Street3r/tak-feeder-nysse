# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
# Old names CLIENT_CERT / CLIENT_KEY still work
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1

# ---------------------------------------------------------------- Nysse
# Line numbers, wildcards allowed (empty = all lines)
#NYSSE_LINE_FILTER=3,60,6*
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- Output
# Seconds between API reads (min 3; default: the moving send interval)
#FETCH_INTERVAL=5
# Seconds between sends of a moving bus (min 1, old name UPDATE_INTERVAL)
# and of a stopped one (min 30, old name REFRESH_INTERVAL). The latest
# position is re-sent at this rate even when the source has nothing new.
#SEND_MOVING_INTERVAL=5
#SEND_STATIONARY_INTERVAL=60
# Below this speed (m/s) a bus counts as stopped
#STATIONARY_SPEED=0.5
# Marker lifetime in ATAK (s); always at least 3 send intervals
#STALE_SECONDS=180
#SOURCE_LINE=Source: Journeys API (ITS Factory, City of Tampere), CC BY 4.0
#DEBUG=0
